# Example Slurm cron table (install with: scrontab examples/scrontab, after editing).
# Every 15 minutes: quota readings, big-file recheck, alerts and reports (seconds of work).
#SCRON --account=ACCOUNT --partition=PARTITION --job-name=labdisk_tick
#SCRON --time=00:10:00 --mem=1G --cpus-per-task=1
#SCRON --output=/dev/null
*/15 * * * * /path/to/python -m labdisk tick

# Daily: scan whatever folders are due, for up to 23 hours, with 4 readers.
#SCRON --account=ACCOUNT --partition=PARTITION --job-name=labdisk_scan
#SCRON --time=23:30:00 --mem=8G --cpus-per-task=4
#SCRON --output=/path/to/labdisk-data/scan-%j.log
7 1 * * * /path/to/python -m labdisk scan --hours 23
